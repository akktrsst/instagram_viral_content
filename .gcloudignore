.gitignore
.gcloudignore
.env
.env.*
!.env.example
.firebase/
.firebaserc
firebase.json
firebase-debug.log
dataconnect/
frontend/
output/
**/__pycache__/
**/*.pyc
**/.pytest_cache/
**/.ruff_cache/
**/*.egg-info/
backend/.venv/
backend/tests/
backend/migrations/
node_modules/
README.md

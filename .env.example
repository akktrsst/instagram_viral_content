# Application
APP_ENV=development
APP_NAME=Viral Content Studio
FRONTEND_ORIGIN=http://localhost:5173

# Google Cloud. Use Application Default Credentials locally; do not create or
# commit service-account key files.
GOOGLE_CLOUD_PROJECT=instagram-viral-content-a8eba
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL_LITE=gemini-3.5-flash-lite
GEMINI_MODEL=gemini-3.8-flash
GEMINI_MODEL_PRO=gemini-3.1-pro-preview
EMBEDDING_MODEL=gemini-embedding-2

# Firebase web app config (public identifiers, not secrets). Copy these from
# Firebase project settings after adding a web app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=instagram-viral-content-a8eba
VITE_FIREBASE_APP_ID=
VITE_USE_FIREBASE_EMULATORS=true

# Bot database. Leave CLOUDSQL_INSTANCE empty to use local SQLite (output/bot.db).
# Instance connection name format: project:region:instance
CLOUDSQL_INSTANCE=
DB_NAME=viral_content
DB_USER=bot
DB_PASSWORD=

# Instagram publishing (Instagram API with Instagram Login). Never commit the token.
IG_USER_ID=
IG_ACCESS_TOKEN=
IG_GRAPH_VERSION=v24.0
MEDIA_BUCKET=instagram-viral-content-a8eba-media

# Emails allowed to use the dashboard (comma-separated).
ADMIN_EMAILS=
IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.5-flash
IMAGE_FALLBACK_MODELS=gemini-nano-banana-2.1
VIDEO_MODEL=veo-3.1-lite-generate-001
VIDEO_LOCATION=us-central1
VIDEO_RESOLUTION=1080p
VIDEO_CLIPS_PER_STORY=2
